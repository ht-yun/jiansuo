{
  "manifest_version": 3,
  "name": "企业信息验证助手",
  "version": "0.3.0",
  "description": "在后台采集国家企业信用信息公示系统公开企业信息，并将候选企业选择交由本地项目页面完成。",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8080/*",
    "https://www.gsxt.gov.cn/*",
    "https://*.gsxt.gov.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "企业信息验证助手",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.gsxt.gov.cn/*",
        "https://*.gsxt.gov.cn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
